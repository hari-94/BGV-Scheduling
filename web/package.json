{
  "name": "bgv-web",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "types": "wrangler types",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "check": "npm run lint && npm run typecheck && npm test",
    "db:migrate:local": "wrangler d1 migrations apply bgv --local",
    "db:migrate:remote": "wrangler d1 migrations apply bgv --remote"
  },
  "dependencies": {
    "hono": "4.13.18",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "@cloudflare/vitest-plugin": "1.8.1",
    "typescript": "5.9.3",
    "vitest": "4.1.12",
    "wrangler": "4.161.0"
  }
}
